packages: */*.cabal

-- Make some warnings errors when you build this repository with cabal. Keep
-- this list in sync with nix/overlays/haskell/strict-warnings.nix, which does
-- the same for the Nix builds in CI. Packages that depend on these packages
-- do not read this file, so their builds do not change.
package temporal-sdk
  ghc-options: -Werror=incomplete-patterns -Werror=incomplete-uni-patterns -Werror=incomplete-record-updates

package temporal-sdk-core
  ghc-options: -Werror=incomplete-patterns -Werror=incomplete-uni-patterns -Werror=incomplete-record-updates

allow-newer:
  base,
  containers,
  ghc

package zlib
  extra-lib-dirs: /nix/store/vx438ll7xvv9q5ns8mqpphsg2dxg9yi9-zlib-1.3.1/lib
  extra-include-dirs: /nix/store/99mambdfxnpm6rkdjbf1hhgdg87caxa3-zlib-1.3.1-dev/include
